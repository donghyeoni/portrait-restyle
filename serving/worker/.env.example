# EC2 워커 환경변수 → /etc/<project>/ai-worker/worker.env
# 백엔드 확정값(2026-09-08)은 채워 두었고, <...> 는 비밀 채널로 받는 값이다. 실제 파일은 저장소에 올리지 않는다.

# ── 소비 활성화 ─────────────────────────────────────────────────────────────
# 공유 큐 + 계정 권한 보완 전. 스모크 테스트와 CPU/GPU E2E 뒤 백엔드와 합의해 true 로
AI_WORKER_CONSUMER_ENABLED=false

# ── RabbitMQ (Host loopback, vhost /<VHOST> 는 URL 에서 %2F<VHOST>) ─────
RABBIT_URL=amqp://<ai-worker>:<PASSWORD>@127.0.0.1:5672/%2F<VHOST>
RABBIT_QUEUE=motion.ai.generate.item
RABBIT_EXCHANGE=motion.ai
RABBIT_ROUTING_KEY=ai.generate.item
RABBIT_RETRY_EXCHANGE=motion.retry.30s
RABBIT_DECLARE=false                  # 큐·교환기는 백엔드가 선언함. 워커는 소비만

# ── 백엔드 콜백 (Nginx /internal/v1/ai-generation-items/** 프록시 보완 완료 확인 후 사용) ──
BACKEND_BASE_URL=https://<BACKEND_HOST>
BACKEND_HMAC_SECRET=<HMAC_SECRET>
BACKEND_TIMEOUT_SEC=15
BACKEND_RESEND=5
HEARTBEAT_SEC=150
WORKER_ID=ec2-worker-01

# ── 카탈로그 GET /collections (백엔드가 http://<ai-worker>:8090/collections 로 호출) ──
AI_PRESET_CATALOG_TOKEN=<CATALOG_TOKEN>
HTTP_BIND=127.0.0.1
HTTP_PORT=8090

# ── S3 ─────────────────────────────────────────────────────────────────────
AWS_REGION=ap-northeast-2
ORIGINAL_BUCKET=<ORIGINAL_BUCKET>
AI_PROCESSED_BUCKET=<AI_PROCESSED_BUCKET>
PRESIGN_TTL_SEC=1800
PREPROCESS_CACHE_S3=false
# 워커 전용 최소권한 인증 (백엔드 준비 중). 인스턴스 역할이면 아무것도 설정하지 않는다.
# 자격 증명 파일로 받으면:  AWS_SHARED_CREDENTIALS_FILE=/secrets/aws-credentials  AWS_PROFILE=ai-worker

# ── GPU 모델 서버 (환경 미정. 비어 있으면 GPU 경로는 GPU_UNAVAILABLE 최종 실패) ──
GPU_SERVICE_URL=
GPU_AUTH_MODE=none                    # none | bearer | gcp-id-token
GPU_AUTH_CREDENTIALS_FILE=            # 예: /secrets/gpu-token 또는 /secrets/gcp-wif.json
GPU_CONNECT_TIMEOUT_SEC=10
GPU_READ_TIMEOUT_SEC=630
GPU_UPLOAD_MODE=relay                 # 공식 경로. presigned 는 S3 서명 PUT POC 후
GPU_IMAGE_ONLY=true
CUTOUT_MAX_SIDE=1200
GLASSES_TO_GPU=true

# ── EC2 CPU 경로 ───────────────────────────────────────────────────────────
CUTOUT_URL=http://127.0.0.1:8001/cutout
INSWAPPER_CTX=-1
